#!/usr/bin/env bash
# Pre-commit hook: enforce formatting, lint, and Cargo.lock consistency.
#
# Install: git config core.hooksPath .githooks
#
# Checks:
#   1. Cargo.lock is staged when modified (prevents dep drift)
#   2. cargo fmt (formatting)
#   3. cargo clippy on all targets with warnings as errors
#   4. cargo check on all targets with `hash-chain` enabled
#   5. cargo nextest run, falling back to cargo test if nextest is missing

set -e

# Stderr from the cargo steps is captured here and replayed only on
# failure: successful commits stay quiet, but a failing step keeps its
# diagnostics — clippy's warnings and nextest's report (including which
# test failed and its output) all go to stderr, and discarding them
# leaves nothing to debug a transient failure with.
STDERR_LOG="$(mktemp)"
trap 'rm -f "$STDERR_LOG"' EXIT

# 1. Cargo.lock must be staged if it has changes.
if ! git diff --quiet -- Cargo.lock 2>/dev/null; then
    echo "error: Cargo.lock has unstaged changes. Stage it with 'git add Cargo.lock'."
    exit 1
fi

# 2. Formatting.
if ! cargo fmt --all --check 2>/dev/null; then
    echo "error: code is not formatted. Run 'cargo fmt --all'."
    exit 1
fi

# 3. Clippy on all targets (lib + tests + benches) with warnings as errors.
if ! cargo clippy --all-targets -- -D warnings 2>"$STDERR_LOG"; then
    cat "$STDERR_LOG" >&2
    echo "error: clippy reported warnings. Fix them and try again."
    exit 1
fi

# 4. Non-default features. Steps 3 and 5 build the default feature set
# only, so code behind an off-by-default feature can stop compiling
# without anything noticing: the `hash-chain` tests in
# `replication/catchup.rs` sat broken for a month and a full release
# that way, because nothing in the loop ever enabled the feature.
# `hash-chain` is the one that matters — it is a production durability
# feature (the tamper-evident audit chain), not a dev toggle. `check`
# rather than `clippy`/`nextest`: catching the compile rot is the whole
# point, and the extra minute of lint/test time per commit is not.
#
# Enabled per package because a virtual workspace has no features of
# its own. Deliberately WITHOUT `--no-default-features` — stripping
# defaults across the workspace breaks the failover suite's binary
# selection and would test a configuration nobody ships.
HASH_CHAIN_PKGS=(melin-journal melin-transport-core melin-server-runtime melin-example-counter)
for pkg in "${HASH_CHAIN_PKGS[@]}"; do
    if ! cargo check -p "$pkg" --all-targets --features hash-chain 2>"$STDERR_LOG"; then
        cat "$STDERR_LOG" >&2
        echo "error: $pkg does not build with --features hash-chain."
        exit 1
    fi
done

# 5. Tests. Prefer cargo-nextest (~3× faster on the failover suite via
# per-test process isolation) and fall back to cargo test if it isn't
# installed. Install with `cargo install cargo-nextest --locked`.
if command -v cargo-nextest >/dev/null 2>&1; then
    if ! cargo nextest run 2>"$STDERR_LOG"; then
        cat "$STDERR_LOG" >&2
        echo "error: tests failed. Fix them and try again."
        exit 1
    fi
else
    echo "note: cargo-nextest not found; falling back to cargo test."
    echo "      install with 'cargo install cargo-nextest --locked' for ~3× faster runs."
    if ! cargo test 2>"$STDERR_LOG"; then
        cat "$STDERR_LOG" >&2
        echo "error: tests failed. Fix them and try again."
        exit 1
    fi
fi
