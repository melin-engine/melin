#!/usr/bin/env bash
# Pre-commit hook: enforce formatting, lint, and Cargo.lock consistency.
#
# Install: git config core.hooksPath .githooks
#
# Checks:
#   1. Cargo.lock is staged when modified (prevents dep drift)
#   2. cargo fmt (formatting)
#   3. cargo clippy on all targets with warnings as errors
#   4. cargo doc with warnings as errors (intra-doc links)
#   5. non-default configurations: the chain-less build
#      (`--no-default-features`), `no-persist` builds and passes its tests
#   6. cargo nextest run, falling back to cargo test if nextest is missing

set -e

# Stderr from the cargo steps is captured here and replayed only on
# failure: successful commits stay quiet, but a failing step keeps its
# diagnostics — clippy's warnings and nextest's report (including which
# test failed and its output) all go to stderr, and discarding them
# leaves nothing to debug a transient failure with.
STDERR_LOG="$(mktemp)"
trap 'rm -f "$STDERR_LOG"' EXIT

# 1. Cargo.lock must be staged if it has changes.
if ! git diff --quiet -- Cargo.lock 2>/dev/null; then
    echo "error: Cargo.lock has unstaged changes. Stage it with 'git add Cargo.lock'."
    exit 1
fi

# 2. Formatting.
if ! cargo fmt --all --check 2>/dev/null; then
    echo "error: code is not formatted. Run 'cargo fmt --all'."
    exit 1
fi

# 3. Clippy on all targets (lib + tests + benches) with warnings as errors.
if ! cargo clippy --all-targets -- -D warnings 2>"$STDERR_LOG"; then
    cat "$STDERR_LOG" >&2
    echo "error: clippy reported warnings. Fix them and try again."
    exit 1
fi

# 4. Doc comments. Clippy does not read them, and rustdoc only warns by
# default, so a link to a renamed or private item renders as plain text
# and nothing fails — forty of them had accumulated across six crates
# before this step existed. `--no-deps` so a dependency's own doc
# warnings cannot fail the commit. Cheap on a warm target: rustdoc reuses
# the check metadata step 3 just built.
if ! RUSTDOCFLAGS='-D warnings' cargo doc --workspace --no-deps 2>"$STDERR_LOG"; then
    cat "$STDERR_LOG" >&2
    echo "error: rustdoc reported warnings (broken intra-doc links?). Fix them and try again."
    exit 1
fi

# 5. Non-default configurations. Steps 3 and 6 build the default feature
# set only, so code the default set does not select can stop compiling
# without anything noticing: the `hash-chain` tests in
# `replication/catchup.rs` sat broken for a month and a full release
# that way, back when the chain was off by default and nothing in the
# loop ever enabled it.
#
# The chain is on by default now, so steps 3 and 6 cover it — including
# running its tests, which a build check never did. What needs guarding
# is the opposite direction: the chain-less build a deployment that wants
# no audit trail selects with `--no-default-features`. `check` rather
# than `clippy`/`nextest`: catching the compile rot is the whole point,
# and the extra minute of lint/test time per commit is not.
#
# `check` is enough to catch dead code left behind by a feature gate
# because `unused` is denied in `[workspace.lints.rust]`, so the
# compiler itself errors rather than warning-and-exiting-0. Do not
# "fix" a failure here by relaxing that — the warning is invisible in
# the default configuration, which is exactly why it needs to be fatal
# in this one.
#
# Per package because a virtual workspace has no features of its own,
# and because stripping defaults workspace-wide would also strip
# unrelated ones.
CHAIN_OFF_PKGS=(
    melin-journal
    melin-transport-core
    melin-server-runtime
    melin-example-counter
)
for pkg in "${CHAIN_OFF_PKGS[@]}"; do
    if ! cargo check -p "$pkg" --all-targets --no-default-features 2>"$STDERR_LOG"; then
        cat "$STDERR_LOG" >&2
        echo "error: $pkg does not build with --no-default-features (hash chain off)."
        exit 1
    fi
done

# `no-persist` needs more than a compile check. Its rot was a *test*
# failure, not a build failure: a recovery test recovering from a
# journal this mode never writes. It compiled, and it passed under
# default features, so nothing short of running the suite with the
# feature on would have caught it. It is a bench/eval toggle rather
# than a shipped durability mode, but a broken one silently invalidates
# a fleet bench run, and the guard costs a few seconds warm.
#
# Only `melin-transport-core` is tested: it owns the semantics, and its
# suite is already written to be valid under the feature (tests that
# need a real journal are `cfg`-gated out). `melin-server-runtime` only
# re-exports the feature, and its integration tests — recovery,
# failover — are meaningless against a journal that is never written,
# so it gets a build check.
#
# Output is captured whole (stdout too, unlike the `check` steps above)
# because a test failure reports on stdout: successful commits stay
# quiet, failing ones keep the report that says which test broke.
if ! cargo test -q -p melin-transport-core --features no-persist >"$STDERR_LOG" 2>&1; then
    cat "$STDERR_LOG" >&2
    echo "error: melin-transport-core fails with --features no-persist."
    exit 1
fi
if ! cargo check -p melin-server-runtime --all-targets --features no-persist 2>"$STDERR_LOG"; then
    cat "$STDERR_LOG" >&2
    echo "error: melin-server-runtime does not build with --features no-persist."
    exit 1
fi

# 6. Tests. Prefer cargo-nextest (~3× faster on the failover suite via
# per-test process isolation) and fall back to cargo test if it isn't
# installed. Install with `cargo install cargo-nextest --locked`.
if command -v cargo-nextest >/dev/null 2>&1; then
    if ! cargo nextest run 2>"$STDERR_LOG"; then
        cat "$STDERR_LOG" >&2
        echo "error: tests failed. Fix them and try again."
        exit 1
    fi
else
    echo "note: cargo-nextest not found; falling back to cargo test."
    echo "      install with 'cargo install cargo-nextest --locked' for ~3× faster runs."
    if ! cargo test 2>"$STDERR_LOG"; then
        cat "$STDERR_LOG" >&2
        echo "error: tests failed. Fix them and try again."
        exit 1
    fi
fi
