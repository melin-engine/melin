# QEMU VM images for DPDK virtio testing.
scripts/dpdk/.cache/

# Bench run outputs (JSON + per-run plots). Default location for
# scripts/lan-bench-suite.sh; one timestamped subdir per run.
/bench-results/

/bench-data/

# Bench plots — only README-referenced PNGs are versioned.
# Everything else can be regenerated via melin-plot.
docs/plots/*
!docs/plots/latency-cdf.png
!docs/plots/latency-stability-tcp-dual-repl-throughput.png
